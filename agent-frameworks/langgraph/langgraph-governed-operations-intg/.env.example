# Leave all values unset to run the standalone workflow without AIGP evidence.
# Set all required values together to send runtime evidence to a local control plane.
# The guide's development-auth server uses 127.0.0.1:8012.
AI_GOVERNANCE_BASE_URL=http://127.0.0.1:8012
AI_GOVERNANCE_ORGANIZATION_ID=org_default
AI_GOVERNANCE_PROJECT_ID=project_default
AI_GOVERNANCE_ACTOR_ID=local-admin
# Required for an authoritative protected operation. This is the workload
# identity the adapter expects AIGP to return; it is not sent in the request
# body. In development it defaults to AI_GOVERNANCE_ACTOR_ID.
# AI_GOVERNANCE_RUNTIME_ACTOR_ID=runtime-service-subject

# Optional in token-authenticated deployments. Never commit a real value.
# AI_GOVERNANCE_ACCESS_TOKEN=

# Optional test-only aliases for `python -m pytest -m integration`.
# Set this explicitly; an exported base URL alone must not run network tests.
# BHANUJ_LAB_INTEGRATION_ENABLED=true
# BHANUJ_LAB_INTEGRATION_BASE_URL=http://127.0.0.1:8012
# BHANUJ_LAB_INTEGRATION_ORGANIZATION_ID=org_default
# BHANUJ_LAB_INTEGRATION_PROJECT_ID=project_default
# BHANUJ_LAB_INTEGRATION_ACTOR_ID=local-admin
# BHANUJ_LAB_INTEGRATION_ACCESS_TOKEN=
