# Required to invoke the real OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local private runtime state. It contains the runtime-owned frozen evidence,
# never Core governance data.
OPENAI_AGENT_RUNTIME_STATE_DIR=./runtime-state
OPENAI_AGENT_RUNTIME_REPLAY_AUTH_TOKEN=change-me
# Privacy-minimizing default: each decision is a fresh constrained response
# (`store=false`). Set provider_state only when native Responses continuation
# via previous_response_id is required; it opts into provider application state.
OPENAI_AGENT_RUNTIME_RESPONSE_CONTINUATION=local

# Set this to the address Core's replay worker can reach. It is frozen into
# observed execution metadata and must exactly equal the worker's allow-list.
OPENAI_AGENT_RUNTIME_PUBLIC_REPLAY_ENDPOINT=http://127.0.0.1:8091/replay

# Required only to ingest observed executions and run the public causal-audit CLI.
AI_GOVERNANCE_BASE_URL=http://127.0.0.1:8000
AI_GOVERNANCE_ORGANIZATION_ID=org_default
AI_GOVERNANCE_PROJECT_ID=project_default
# Optional for an authenticated Core deployment. Supply an already-issued,
# short-lived bearer token; never store a client secret in this file.
AI_GOVERNANCE_API_BEARER_TOKEN=
